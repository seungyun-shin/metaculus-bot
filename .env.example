# =============================================================================
# Metaculus calibrated bot - environment variables
#
# Local use:   cp .env.example .env   then fill in the values (never commit .env)
# GitHub:      Settings -> Secrets and variables -> Actions
#              keys/tokens  -> "Secrets"   tab
#              BOT_* knobs  -> "Variables" tab (optional)
# =============================================================================

# ---- REQUIRED ----------------------------------------------------------------
# Bot account token: https://www.metaculus.com/futureeval/participate/
METACULUS_TOKEN=REPLACE_ME

# ---- LLM ACCESS (optional; first one found is used) ---------------------------
# 1) OpenRouter key. The free LLM credits from the participation form
#    (https://forms.gle/aQdYMq9Pisrf1v7d8) are delivered as an OpenRouter key.
# OPENROUTER_API_KEY=REPLACE_ME
# 2) Your own Anthropic key (Claude Sonnet 5.5 by default, BOT_MODEL=opus for Opus 5.5)
# ANTHROPIC_API_KEY=REPLACE_ME
# 3) Nothing set -> the Metaculus LLM proxy (metaculus/gpt-4o) using METACULUS_TOKEN only.

# ---- NEWS SEARCH (optional) ----------------------------------------------------
# AskNews (https://asknews.app/). Without these the bot forecasts with no search.
# ASKNEWS_CLIENT_ID=REPLACE_ME
# ASKNEWS_SECRET=REPLACE_ME
# ASKNEWS_API_KEY=REPLACE_ME   # alternative to client id + secret

# ---- BOT SETTINGS (all optional; defaults shown) ------------------------------
# BOT_LLM_PROVIDER=auto              # auto | openrouter | anthropic | metaculus_proxy
# BOT_MODEL=                         # sonnet | opus | haiku, or a full litellm string
#                                    #   e.g. openrouter/anthropic/claude-opus-5.5
# BOT_PARSER_MODEL=                  # model that reads answers when the regex fails
# BOT_EFFORT=medium                  # low|medium|high|xhigh|max (ANTHROPIC_API_KEY only)
# BOT_RESEARCH=auto                  # auto | asknews | none
# BOT_PREDICTIONS_PER_QUESTION=5     # samples per question, aggregated by median
# BOT_MAX_COST_PER_QUESTION_USD=1.0  # 0 = unlimited
# BOT_MAX_COST_PER_RUN_USD=10.0      # 0 = unlimited
# BOT_MAX_QUESTIONS_PER_RUN=20       # 0 = unlimited (FutureEval + MiniBench combined)
# BOT_PUBLISH=true                   # false = dry run (same as --dry-run)
# BOT_MAX_TOKENS=16000
# BOT_LLM_TIMEOUT_SECONDS=300
